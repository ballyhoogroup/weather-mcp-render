{
  "name": "weather-mcp-render",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "description": "A tiny remote MCP weather server for Claude, deployable on Render.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "node --check src/index.js && node --check test/weather.test.js",
    "build": "node --check src/index.js",
    "start": "node src/index.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@supportbridge/sdk": "0.9.7",
    "jose": "6.1.0",
    "zod": "^3.25.76"
  }
}
